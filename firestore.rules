rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return request.auth.uid == ownerId;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // ── Users ───────────────────────────────────────────────────────────────
    // Users can only read and write their own profile document.
    match /users/{uid} {
      allow read:   if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated() && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow update: if isAuthenticated() && request.auth.uid == uid
                    // Prevent modifying immutable identity fields
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.employee_id == resource.data.employee_id
                    && request.resource.data.clearance_level == resource.data.clearance_level;
      allow delete: if false; // Only admins via Admin SDK can delete user records
    }

    // ── Sources ─────────────────────────────────────────────────────────────
    // Operators can only access their own source documents.
    match /sources/{sourceId} {
      allow read:   if isAuthenticated() && isOwner(resource.data.ownerId);
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && isValidString(request.resource.data.sourceName, 500);
      allow update: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow delete: if false; // Handled server-side
    }

    // ── Projects ────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read:   if isAuthenticated() && isOwner(resource.data.ownerId);
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow delete: if false;
    }

    // ── Outputs ─────────────────────────────────────────────────────────────
    match /outputs/{outputId} {
      allow read:   if isAuthenticated() && isOwner(resource.data.ownerId);
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource.data.ownerId);
      allow delete: if false;
    }

    // ── Generation History ──────────────────────────────────────────────────
    match /generation_history/{historyId} {
      allow read:   if isAuthenticated() && isOwner(resource.data.ownerId);
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if false; // History records are immutable
      allow delete: if false;
    }

    // ── Analyses (legacy subcollection support) ──────────────────────────────
    match /analyses/{analysisId} {
      allow read:   if isAuthenticated() && isOwner(resource.data.ownerId);
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ── Deny all other paths ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
