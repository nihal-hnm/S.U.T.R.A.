# S.U.T.R.A. Frontend — Environment Variables
# Copy this file to .env.local and fill in your Firebase project details.
# Never commit .env.local to source control.

# ─────────────────────────────────────────────────────────
# Firebase Web App Config
# Get these values from: Firebase Console → Project Settings → Your Apps
# ─────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ─────────────────────────────────────────────────────────
# Backend API URL
# Local dev (Firebase Emulator):  http://localhost:5001/your-project-id/us-central1/api
# Production (Cloud Functions):   https://us-central1-your-project-id.cloudfunctions.net/api
# ─────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5001/your-project-id/us-central1/api

# ─────────────────────────────────────────────────────────
# Optional: Connect to Firebase Local Emulator Suite
# Set to "true" only during local development with emulators running.
# Run: firebase emulators:start --only auth,firestore,functions,storage
# ─────────────────────────────────────────────────────────
VITE_USE_EMULATOR=false
